# Copy this file to .env and fill in your own values (run.bat does the copy for you on first start).
# Never commit .env: it holds your API keys. This example file is safe to commit.

# ================================================================ AI providers
# Fill in the keys you have. Providers without a key are hidden in the model picker.
# OpenRouter free tier: 50 requests/day across all ":free" models while the balance is $0.
# Get a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Local models with Ollama (https://ollama.com): uncomment to enable
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ================================================================ default models (provider:model)
# Used by anyone without their own model. Change them in Settings inside the app too.
DEFAULT_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
VISION_MODEL=openrouter:google/gemma-4-31b-it:free
# OpenRouter only: tried in the same request if the chosen OpenRouter model is busy
MODEL_FALLBACKS=google/gemma-4-31b-it:free,openrouter/free

# ================================================================ web server
# HOST=0.0.0.0 lets your phone on the same Wi-Fi open the app (HOST=127.0.0.1 = this PC only)
HOST=0.0.0.0
PORT=8765
